# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bidiq?appName=Cluster0

# ── Authentication ──────────────────────────────────────────────────────────
# Generate a strong random string, e.g.: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# ── LLM Default Fallback ────────────────────────────────────────────────────
# Used only if a task-specific provider is not set below.
# Options: openrouter | huggingface | ollama
LLM_PROVIDER=openrouter

# ── Per-Task LLM Provider Routing ───────────────────────────────────────────
# Each task independently dispatches to its own LLM provider.
# Options: openrouter | huggingface | ollama
# If a provider fails, the system automatically falls back to the next available.
EXTRACTION_LLM_PROVIDER=openrouter
MATCH_LLM_PROVIDER=huggingface
DRAFT_LLM_PROVIDER=huggingface
SCORE_LLM_PROVIDER=openrouter

# ── OpenRouter ──────────────────────────────────────────────────────────────
# Get a free API key at https://openrouter.ai
# Recommended free model: inclusionai/ling-3.0-flash:free
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# ── Hugging Face ────────────────────────────────────────────────────────────
# Get a free access token at https://huggingface.co/settings/tokens
# Recommended model: Qwen/Qwen2.5-7B-Instruct (fast, free, instruction-tuned)
HF_API_KEY=hf_your_key_here
HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
HF_INFERENCE_URL=https://api-inference.huggingface.co/models
HF_MODEL_DEFAULT=Qwen/Qwen2.5-7B-Instruct

# ── Ollama (Local Inference) ────────────────────────────────────────────────
# Install Ollama from https://ollama.com and pull a model:
#   ollama pull phi4-mini:latest
# Leave as-is if using cloud providers only.
OLLAMA_MODEL=phi4-mini:latest
OLLAMA_HOST=http://127.0.0.1:11434
